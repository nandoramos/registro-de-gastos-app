# Solo placeholders. Copiar a .env.local y completar en privado.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Identificador OIDC "sub" de la única cuenta Google autorizada; no es un email.
GOOGLE_ALLOWED_SUB=REPLACE_WITH_GOOGLE_SUB
